# Demos node to poll
DEMOS_RPC_URL=http://localhost:53550

# EVM network (Base Sepolia default)
EVM_RPC_URL=https://sepolia.base.org

# ── Key management ────────────────────────────────────────────────────────────
# The oracle wallet is stored as an encrypted JSON keystore (AES-256 / scrypt).
# Raw private keys are never placed in this file.
#
# To create the keystore from a raw key:
#   ORACLE_PRIVATE_KEY=0x... bun run scripts/encrypt-key.ts oracle.keystore.json
#
# Then set these two variables:
KEYSTORE_PATH=./oracle.keystore.json
KEYSTORE_PASSWORD=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD

# ZKOracleRegistry contract address (set after deployment)
CONTRACT_ADDRESS=REPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# How often to poll Demos for new roots (milliseconds)
POLL_INTERVAL_MS=10000
