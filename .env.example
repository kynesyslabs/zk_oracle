# ── Demos nodes ───────────────────────────────────────────────────────────────
# Comma-separated. The oracle votes only when the nodes agree on
# (root, block, leafCount, genesis). Use nodes run by different operators.
DEMOS_RPC_URLS=https://node-a.example,https://node-b.example,https://node-c.example
# Default: every node that answers must agree, and at least 2 must answer
# (1 when a single URL is configured). Set k to vote on k identical answers.
# DEMOS_QUORUM=2
# DEMOS_FETCH_TIMEOUT_MS=5000

# ── EVM network: required, no default ────────────────────────────────────────
# The RPC must serve EVM_CHAIN_ID; the oracle refuses to start otherwise.
# Examples: Ethereum Sepolia 11155111, Base Sepolia 84532, Base 8453.
EVM_RPC_URL=REPLACE_WITH_THE_TARGET_NETWORK_RPC_URL
EVM_CHAIN_ID=REPLACE_WITH_THE_TARGET_CHAIN_ID
# Label used in logs and /health.
EVM_NETWORK_NAME=REPLACE_WITH_THE_NETWORK_NAME

# ZKIdentityRegistry address (set after deployment)
CONTRACT_ADDRESS=REPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# ── Transactions ──────────────────────────────────────────────────────────────
# Hard caps on the fees a vote may pay, in gwei.
MAX_FEE_PER_GAS_GWEI=100
MAX_PRIORITY_FEE_PER_GAS_GWEI=2
# A vote not mined within TX_WAIT_TIMEOUT_MS is replaced at the same nonce with
# fees raised by FEE_BUMP_PERCENT (>= 10), at most MAX_FEE_BUMPS times.
TX_WAIT_TIMEOUT_MS=120000
FEE_BUMP_PERCENT=25
MAX_FEE_BUMPS=3

# ── Key management ────────────────────────────────────────────────────────────
# The oracle wallet is an encrypted JSON keystore (AES-256 / scrypt), mounted
# as a file. Raw private keys are never placed in this file.
#
# To create the keystore from a raw key:
#   ORACLE_PRIVATE_KEY=0x... bun run scripts/encrypt-key.ts oracle.keystore.json
KEYSTORE_PATH=./oracle.keystore.json
KEYSTORE_PASSWORD=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD

# ── Loop and health ───────────────────────────────────────────────────────────
POLL_INTERVAL_MS=10000
# GET /health on this port (0 disables). In Docker the container port is fixed
# at 8080; HEALTH_HOST_PORT picks the host loopback port.
HEALTH_PORT=8080
# Bind address; loopback by default (compose sets 0.0.0.0 inside the container).
# HEALTH_HOST=127.0.0.1
# /health turns unhealthy when the registry stays behind the nodes this many polls.
# MAX_LAG_POLLS=30
# Optional sanity ceiling on the Demos block number a node may report.
# MAX_DEMOS_BLOCK=
